--- !u!114 &1526772277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1526772272}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9835564300e65fb4b93a166d55822cec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Poat\xE3n FINALMENTE, estava te procurando, ta tudo um caos nessa floresta."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Fala saci, oque ta acontecendo? tem tatu me batendo, macaco tacando c\xF4co,
      n\xE3o to entendo nada."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "\xC9 voc\xEA sabe bem que n\xE3o o comportamento padr\xE3o deles. Tem
      algo de errado sim, e MUITO errado."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Eu sabia, al\xE9m dos animais t\xF4 sentindo um cheiro de fuma\xE7a."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Ent\xE3o menino, o Curupira ta tacando fogo na floresta, e agindo como
      se fosse uma besta."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Logo o Curupira? mas ele n\xE3o \xE9 disso. Tem dedo da Cuca nessa hist\xF3ria
      n\xE9?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Se fosse s\xF3 dedo tava bom, a salafr\xE1ria enfeiti\xE7ou todos os Guardi\xF5es,
      o mais perto daqui \xE9 o Curupira."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Vou ter que resolver isso sozinho n\xE9?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "E quem mais seria? Curupira tem 2 p\xE9s ao contr\xE1rio mas eu s\xF3
      tenho uma perna."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "N\xE3o tenho argumento contra..."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Mas eu to aqui pra te ajudar, vou xeretando por ai e te contando oque
      est\xE1 acontecendo"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Agora corre, se n\xE3o o Curupira vai acabar com tudo\n."
  playerLayer:
    serializedVersion: 2
    m_Bits: 1024
  radius: 1.7
