--- !u!114 &1410301771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1410301769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9835564300e65fb4b93a166d55822cec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Eai Saci, alguma not\xEDcia?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "S\xF3 uma, voc\xEA chegou onde o Curupira est\xE1, \xE9 aqui na frente
      que ele ta tacando fogo em tudo, s\xF3 vim te avisar pra tomar cuidado porque
      ele est\xE1 MUITO estressado."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Vim pra te desejar boa sorte tamb\xE9m."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: Valeu por avisar. Prometo que vou trazer a paz de volta para a floresta.
  playerLayer:
    serializedVersion: 2
    m_Bits: 1024
  radius: 1.7
