--- !u!114 &1347263201
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1347263199}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9835564300e65fb4b93a166d55822cec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Voc\xEA deve estar se perguntando \"Mas saci, porque estou matando os
      animais sendo que eu tenho que salvar a floresta?\""
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Eu te explico, voc\xEA n\xE3o esta matando ninguem, ta vendo que eles
      viram fuma\xE7a e somem?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "No momento que isso acontece significa que voc\xEA ta libertando eles
      da maldi\xE7\xE3o que a cuca fez, eles somem e aparecem no lugar onde moram."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: Leu minha mente, ia te perguntar isso agora.
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Enquanto voc\xEA vem com a farinha, eu j\xE1 voltei com o bolo."
  playerLayer:
    serializedVersion: 2
    m_Bits: 1024
  radius: 1.7
