--- !u!114 &7881695985564910720
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1463554090374859441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9835564300e65fb4b93a166d55822cec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: Pronto. O Curupira voltou ao normal... Mais um livrado da Cuca.
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Quase que ele te torra inteiro! C\xEA \xE9 corajoso, hein?"
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "S\xF3 fiz oque eu tinha que fazer. Quem \xE9 o pr\xF3ximo?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Ihhh... Agora c\xEA vai ter que encarar os campos da Caipora."
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Ela tamb\xE9m t\xE1 enfeiti\xE7ada?"
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "T\xE1 mais surtada que pernilongo em quarto fechado. Nem reconhece mais
      amigo de inimigo!"
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "\xD3timo... Ent\xE3o \xE9 pra l\xE1 que eu vou."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "S\xF3 vai com calma, guerreiro, fiquei sabendo que tem armadilha at\xE9
      em sombra, e dizem que at\xE9 o vento l\xE1 sopra ao contr\xE1rio!"
  - speakerIcon: {fileID: 21300000, guid: 6852a1324a19b5646ba6b64f0fc95e27, type: 3}
    speakerName: "Poat\xE3n"
    text: "Se a Caipora ainda t\xE1 l\xE1, eu vou traz\xEA-la de volta."
  - speakerIcon: {fileID: 21300000, guid: 9d84e24bc0c73664e9706e14581941e5, type: 3}
    speakerName: Saci Perere
    text: "Gosto de ver essa confian\xE7a! Mas leva um repelente, vai por mim."
  playerLayer:
    serializedVersion: 2
    m_Bits: 1024
  radius: 1.7
